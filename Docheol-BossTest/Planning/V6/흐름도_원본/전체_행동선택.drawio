<mxfile host="app.diagrams.net" modified="2026-10-05T16:50:00.000Z" agent="dot" version="26.0.0" type="device"><diagram id="Docheol_V6_Action_Selection" name="전체 행동 선택"><mxGraphModel dx="1600" dy="2280" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="2280" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="도철 V6 · 전체 행동 선택" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#243E59;fontFamily=Noto Sans CJK KR;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="30" width="1440" height="50" as="geometry" /></mxCell><mxCell id="subtitle" value="V6 b05 · 24bad623 · 현재 구현의 판단 순서. 가중치는 고정 전역 확률이 아닙니다." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#243E59;fontFamily=Noto Sans CJK KR;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="1440" height="35" as="geometry" /></mxCell><mxCell id="start" value="일반 판단 진입&#10;Idle·판단 대기·안전 대기·자세 안정" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#EFF4F7;strokeColor=#587084;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="160" width="400" height="95" as="geometry" /></mxCell><mxCell id="death" value="사망은 어느 상태에서도 종료&#10;보스 사망 → 승리 / 플레이어 사망 → 패배&#10;공격·예약·낙석·마커 중지" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#F5E9E5;strokeColor=#A27768;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1100" y="160" width="400" height="135" as="geometry" /></mxCell><mxCell id="phase" value="페이즈 전환&#10;예약이 있는가?" style="shape=rhombus;whiteSpace=wrap;html=0;rounded=0;arcSize=12;fillColor=#FFF5D8;strokeColor=#B1892B;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="300" width="300" height="145" as="geometry" /></mxCell><mxCell id="transition" value="페이즈 전환 1.70초&#10;갑주 탈락 0.12 → 늘어짐 0.68&#10;포효 0.90. 조작·양측 피해 잠금&#10;P2·낙석 시작 → 대기 0.40" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#E8EDF7;strokeColor=#6478A0;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="285" width="400" height="180" as="geometry" /></mxCell><mxCell id="late" value="P2 후반 낙석 예약?&#10;낙석·땅굴 묶음이&#10;끝났는가?" style="shape=rhombus;whiteSpace=wrap;html=0;rounded=0;arcSize=12;fillColor=#FFF5D8;strokeColor=#B1892B;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="510" width="300" height="155" as="geometry" /></mxCell><mxCell id="roar" value="후반 포효·낙석&#10;호흡 0.55 → 포효 0.60&#10;직접 피해 없음&#10;낙석 시작 → 대기 0.35" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#E8EDF7;strokeColor=#6478A0;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1100" y="505" width="400" height="170" as="geometry" /></mxCell><mxCell id="snapshot" value="새 판단에서 목표 1회 저장&#10;위치·방향 준비에도 같은 목표 재사용" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#EFF4F7;strokeColor=#587084;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="730" width="400" height="95" as="geometry" /></mxCell><mxCell id="prepare" value="필요하면 돌아서기 1회·이동 1회&#10;돌아서기 0.78 → 안정 자세 0.14&#10;추가 추적·무한 방향 전환 없음" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#EFF4F7;strokeColor=#587084;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="890" width="400" height="115" as="geometry" /></mxCell><mxCell id="wallnote" value="벽에서 이동할 공간이 부족하면&#10;가능 거리 &lt; 0.12u + 낙석 없음&#10;땅굴 쿨다운 완료·묶음 없음&#10;즉시 땅굴로 전환 가능" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B5C0C9;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="850" width="400" height="170" as="geometry" /></mxCell><mxCell id="locked" value="낙석 중&#10;플레이어가 잠긴&#10;동작 중인가?" style="shape=rhombus;whiteSpace=wrap;html=0;rounded=0;arcSize=12;fillColor=#FFF5D8;strokeColor=#B1892B;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="1070" width="300" height="155" as="geometry" /></mxCell><mxCell id="waiting" value="안전 대기 0.12초&#10;일반 판단에 다시 진입" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#EFF4F7;strokeColor=#587084;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="1095" width="400" height="105" as="geometry" /></mxCell><mxCell id="candidates" value="준비 계획 검사 → 유효 후보 선택&#10;P1 물기 1.35 / 앞발 1.35 / 연계 0.32&#10;P2 물기 1.10 / 앞발 1.10 / 연계 3.25&#10;땅굴 0.40 / 지상 5연타 0.65" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#E8F0E8;strokeColor=#5C815D;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="1290" width="400" height="185" as="geometry" /></mxCell><mxCell id="gates" value="후보 조건을 먼저 확인&#10;정면·거리·벽·쿨다운·피할 길&#10;낙석 중에는 기본기·연계만&#10;땅굴: 일반 선택은 2묶음 완료 뒤&#10;지상 5연타: P2·유효 좌우 범위&#10;최근 3회 같은 코드마다 ×0.55&#10;지상 5연타는 최근 기록에서 제외" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B5C0C9;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1100" y="1055" width="400" height="280" as="geometry" /></mxCell><mxCell id="empty" value="유효 후보 합이&#10;0.0001 미만인가?" style="shape=rhombus;whiteSpace=wrap;html=0;rounded=0;arcSize=12;fillColor=#FFF5D8;strokeColor=#B1892B;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="1535" width="300" height="135" as="geometry" /></mxCell><mxCell id="fallback" value="후보가 없을 때&#10;낙석 없음 → 앞발 2&#10;낙석 있음 → 안전 대기 0.12" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#EFF4F7;strokeColor=#587084;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="1535" width="400" height="125" as="geometry" /></mxCell><mxCell id="execute" value="선택한 순서 끝까지 실행&#10;예고 → 실제 공격&#10;물기 → 앞발은 연결 0.08 → 다음 예고&#10;땅굴은 별도 3분기 흐름도 참고" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#E8F0E8;strokeColor=#5C815D;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="1730" width="400" height="155" as="geometry" /></mxCell><mxCell id="exception" value="땅굴 A 종료는 별도 분기&#10;60%: 다음 땅굴 직결&#10;40%: 재출현 → 판단 대기&#10;직결은 일반 선택·쿨다운 검사 생략&#10;전환·후반 예약 판단도 지연&#10;현재 A 연속 상한 2회" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#B5C0C9;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=17;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1100" y="1550" width="400" height="260" as="geometry" /></mxCell><mxCell id="recovery" value="최종 회복을 끝까지 유지&#10;5연타 1.90 / 높은 도약 1.15" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#EFF4F7;strokeColor=#587084;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="1950" width="400" height="90" as="geometry" /></mxCell><mxCell id="wait" value="판단 대기&#10;P1 1.15~1.33 / P2 0.32~0.44" style="shape=rectangle;whiteSpace=wrap;html=0;rounded=1;arcSize=12;fillColor=#EFF4F7;strokeColor=#587084;strokeWidth=2;fontColor=#243745;fontFamily=Noto Sans CJK KR;fontSize=18;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="550" y="2100" width="400" height="80" as="geometry" /></mxCell><mxCell id="source" value="근거: DoCheolBossController.SelectPattern·FixedUpdate·FinishAttack / DoCheolV6Burrow. 현재 코드 테스트값" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#243E59;fontFamily=Noto Sans CJK KR;fontSize=18;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="70" y="2220" width="1440" height="35" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=none;orthogonal=1;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#536B7C;strokeWidth=2.4;fontColor=#334C5D;fontSize=16;fontFamily=Noto Sans CJK KR;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="start" target="phase"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="255" as="sourcePoint" /><mxPoint x="750" y="300" as="targetPoint" /><Array as="points" /></mxGeometry></mxCell><mxCell id="e2" value="예" style="edgeStyle=none;orthogonal=1;rounded=0;html=0;endArrow=block;endFill=1;strokeColor=#536B7C;strokeWidth=2.4;fontColor=#334C5D;fontSize=16;fontFamily=Noto Sans CJK KR;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="phase" target="transit